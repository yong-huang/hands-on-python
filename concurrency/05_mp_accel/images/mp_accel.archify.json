      "row": 1,
      "tag": "字节码真并行"
    },
    {
      "id": "results",
      "type": "database",
      "label": "pool.map 保序",
      "sublabel": "完成乱序结果不乱",
      "stage": 3,
      "row": 1
    },
    {
      "id": "threads",
      "type": "external",
      "label": "threading ×4",
      "sublabel": "GIL 串行化 · 实测 0.78×",
      "stage": 1,
      "row": 2,
      "tag": "对照"
    }
