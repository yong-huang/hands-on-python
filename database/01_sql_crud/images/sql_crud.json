  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "execute() 把 SQL 交给进程内的 SQLite，没有网络往返",
        "解析器生成执行计划，写入前逐项过五类约束",
        "通过即落 B-tree 存储页，结果以 Row 对象回传"
      ]
    },
    {
      "dot": "amber",
      "title": "五类约束各拦一种非法",
      "items": [
        "PRIMARY KEY 拒重复 id，NOT NULL 拒缺字段",
        "UNIQUE 拒重复 sku，CHECK 拒 price < 0",
        "FOREIGN KEY 拒悬空引用——但默认关闭，须 PRAGMA foreign_keys=ON"
      ]
    },
    {
      "dot": "rose",
      "title": "两条出口只隔一个占位符",
      "items": [
        "占位符 ? 把输入当数据：载荷原样进 LIKE，命中 0 行",
        "字符串拼接把输入当代码：' OR '1'='1 让 WHERE 恒真，全表外泄"
      ]
    }
  ]
}
