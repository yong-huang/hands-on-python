  "cards": [
    {
      "dot": "cyan",
      "title": "两个 1MB 是两回事",
      "items": [
        "写入侧：SpooledTemporaryFile 的溢出阈值，决定内容放内存还是磁盘",
        "读取侧：视图 read 的分块大小，只影响 read() 调用几次，互不依赖"
      ]
    },
    {
      "dot": "rose",
      "title": "防线要挂在读完之前",
      "items": [
        "415 白名单在读之前断；413 边读边计数，中途断并删半成品",
        "multipart 解析在端点运行前已完成，网络边界的拦截要靠反向代理"
      ]
    },
    {
      "dot": "emerald",
      "title": "元数据是声称不是事实",
      "items": [
        "filename / content_type 由客户端声明，可伪造，白名单要看扩展名与魔数",
        "size 以边读边数为准，与磁盘字节数对照，不单独当凭据"
      ]
    }
  ]
