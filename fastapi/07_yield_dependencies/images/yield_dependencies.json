  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "route",
      "y": 172,
      "label": "POST /orders",
      "variant": "emphasis"
    },
    {
      "id": "tx-setup",
      "from": "route",
      "to": "tx",
      "y": 202,
      "label": "setup · tx:begin"
    },
    {
      "id": "tx-yield",
      "from": "tx",
      "to": "route",
      "y": 230,
      "label": "yield \"tx#1\"",
      "variant": "return"
    },
    {
      "id": "audit-setup",
      "from": "route",
      "to": "audit",
      "y": 260,
      "label": "setup · audit:setup"
    },
    {
      "id": "audit-yield",
      "from": "audit",
      "to": "route",
      "y": 288,
      "label": "yield \"audit\"",
      "variant": "return"
    },
    {
      "id": "call-endpoint",
      "from": "route",
      "to": "endpoint",
      "y": 320,
      "label": "调用端点(setup 全部完成)",
      "variant": "emphasis"
    },
    {
      "id": "endpoint-return",
      "from": "endpoint",
      "to": "route",
      "y": 348,
      "label": "return 响应对象",
      "variant": "return"
    },
    {
      "id": "response",
      "from": "route",
      "to": "client",
      "y": 380,
      "label": "200 响应已发送",
      "variant": "return",
      "note": "此刻 teardown 还没跑:audit 的 0.5s sleep 不拖慢响应"
    },
    {
      "id": "audit-teardown",
      "from": "route",
      "to": "audit",
      "y": 416,
      "label": "teardown · audit:teardown",
      "note": "后进先出:后 setup 的先收尾"
    },
    {
      "id": "tx-teardown",
      "from": "route",
      "to": "tx",
      "y": 444,
