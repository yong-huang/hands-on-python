  "cards": [
    {
      "dot": "emerald",
      "title": "正常路径",
      "items": [
        "setup 顺序 = 声明顺序:transaction 先 BEGIN,audit 后登记",
        "端点运行在所有 setup 之后、任何 teardown 之前",
        "teardown 后进先出:先 audit:teardown,再 tx:commit"
      ]
    },
    {
      "dot": "amber",
      "title": "时序关键点",
      "items": [
        "正常路径 teardown 在响应发送之后执行",
        "audit 的 0.5s sleep 不拖慢响应,只推迟事件记录",
        "端点异常时 teardown 抢在错误响应之前执行"
      ]
    },
    {
      "dot": "rose",
      "title": "失败路径",
      "items": [
        "端点抛 HTTPException 从 yield 点穿回生成器",
        "transaction 的 except 记录 ROLLBACK 并原样 re-raise",
        "错误响应等 teardown 全部跑完才发出"
      ]
    }
  ]
}