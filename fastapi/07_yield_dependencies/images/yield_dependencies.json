    },
    {
      "id": "boom-request",
      "from": "client",
      "to": "route",
      "y": 492,
      "label": "POST /boom"
    },
    {
      "id": "boom-call",
      "from": "route",
      "to": "endpoint",
      "y": 520,
      "label": "调用端点"
    },
    {
      "id": "boom-raise",
      "from": "endpoint",
      "to": "route",
      "y": 550,
      "label": "抛 HTTPException(418)",
      "variant": "emphasis",
      "note": "异常从 yield 点穿回两个生成器"
    },
    {
      "id": "boom-audit",
      "from": "route",
      "to": "audit",
      "y": 580,
      "label": "teardown · audit:teardown",
      "note": "异常路径:先于错误响应执行"
    },
    {
      "id": "boom-rollback",
      "from": "route",
      "to": "tx",
      "y": 608,
      "label": "except 分支 · tx:rollback 后原样 re-raise"
    },
    {
      "id": "boom-response",
      "from": "route",
      "to": "client",
      "y": 636,
      "label": "418 错误响应(等 teardown 跑完才发出)",
      "variant": "return"
    }
