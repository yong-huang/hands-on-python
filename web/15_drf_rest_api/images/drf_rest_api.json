  "cards": [
    {
      "dot": "cyan",
      "title": "三层抽象各管一段（实测）",
      "items": [
        "Router 自动生成 CRUD 路由；@action 一行注册 /articles/recent/",
        "ViewSet 一个类五个视图；Serializer 读写分离——读嵌套 author、写收 author_id"
      ]
    },
    {
      "dot": "amber",
      "title": "状态码即协议（实测）",
      "items": [
        "匿名写 403（权限层）、缺字段 400（校验层指向字段名）、201/200/204 全链路",
        "分页由全局 PAGE_SIZE=5 配置：count=7、第二页 2 条"
      ]
    }
