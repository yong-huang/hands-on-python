{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "JWT 认证全链路：签发与三关校验",
    "locale": "zh-CN",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "合法用户的三关之旅"
    },
    {
      "id": "edgepath",
      "label": "401 拒绝路径",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "login",
    "verify",
    "sign",
    "extract",
    "decode",
    "me"
  ],
  "nodes": [
    {
      "id": "login",
      "lane": "main",
      "col": 0,
      "type": "external",
      "label": "POST /token 账号密码",
      "width": 170
    },
    {
      "id": "verify",
      "lane": "main",
      "col": 1,
      "type": "backend",
      "label": "bcrypt.checkpw 校验",
      "width": 170
    },
    {
      "id": "sign",
      "lane": "main",
      "col": 2,
      "type": "messagebus",
      "label": "PyJWT 签发 HS256",
      "width": 160
    },
    {
      "id": "extract",
      "lane": "main",
      "col": 3,
      "type": "backend",
      "label": "OAuth2PasswordBearer 取 Bearer",
      "width": 200
    },
    {
      "id": "decode",
      "lane": "main",
      "col": 4,
      "type": "database",
      "label": "jwt.decode 验签 + 过期",
      "width": 180
    },
    {
      "id": "me",
      "lane": "main",
      "col": 5,
      "type": "external",
      "label": "GET /me 200",
      "width": 130
    },
    {
      "id": "lock401",
      "lane": "edgepath",
      "col": 1,
      "type": "security",
      "label": "错误密码 → 401 统一文案",
      "width": 190
    },
    {
      "id": "e401",
      "lane": "edgepath",
      "col": 4,
      "type": "security",
      "label": "缺失/篡改/错密钥/过期 → 401",
      "width": 210
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "login",
      "to": "verify",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "verify",
      "to": "sign",
      "label": "哈希匹配 · 计数清零"
    },
    {
      "id": "e3",
      "from": "sign",
      "to": "extract",
      "label": "token 三段式",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "extract",
      "to": "decode"
    },
    {
      "id": "e5",
      "from": "decode",
      "to": "me",
      "label": "claims 放行"
    },
    {
      "id": "e6",
      "from": "verify",
      "to": "lock401",
      "label": "不匹配"
    },
    {
      "id": "e7",
      "from": "decode",
      "to": "e401",
      "label": "任一关失败"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "JWT 结构与边界（实测）",
      "items": [
        "header.payload.signature 三段式——项目 3 的结论原样成立：防篡改、不保密、不防窃取",
        "exp 是独立的一关：过期 token 签名合法也 401（ExpiredSignatureError 实测）"
      ]
    },
    {
      "dot": "amber",
      "title": "密码与枚举防护",
      "items": [
        "bcrypt 慢哈希 + 盐，checkpw 恒时比较；库里只有 $2b 开头的哈希",
        "错误密码与用户不存在返回统一 401 文案——不给探测者枚举用户名的线索"
      ]
    }
  ]
}
