      "type": "external",
      "label": "POST /login 账号密码",
      "width": 170
    },
    {
      "id": "issue",
      "lane": "main",
      "col": 1,
      "type": "messagebus",
      "label": "Set-Cookie 二选一",
      "width": 180
    },
    {
      "id": "carry",
      "lane": "main",
      "col": 2,
      "type": "backend",
      "label": "GET /protected 带 Cookie 头",
      "width": 190
    },
    {
      "id": "verify",
      "lane": "main",
      "col": 3,
      "type": "database",
      "label": "校验登录态",
      "width": 180
    },
    {
      "id": "ok",
      "lane": "main",
      "col": 4,
      "type": "messagebus",
      "label": "200 whoami",
      "width": 150
    },
    {
      "id": "noauth",
      "lane": "reject",
      "col": 2,
      "type": "security",
      "label": "无 cookie → 401",
      "width": 160
    },
    {
      "id": "bad",
      "lane": "reject",
      "col": 3,
      "type": "security",
      "label": "篡改 / 过期 → 401",
      "width": 170
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "login",
      "to": "issue",
      "label": "密码正确才签发",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "issue",
      "to": "carry",
      "label": "浏览器自动回带"
    },
    {
      "id": "e3",
      "from": "carry",
