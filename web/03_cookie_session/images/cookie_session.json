    },
    {
      "id": "e4",
      "from": "verify",
      "to": "ok",
      "label": "两关全过",
      "variant": "emphasis"
    },
    {
      "id": "e5",
      "from": "carry",
      "to": "noauth",
      "label": "裸请求"
    },
    {
      "id": "e6",
      "from": "verify",
      "to": "bad",
      "label": "任一关失败"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "两种存法对照",
      "items": [
        "服务端 session：cookie 只放随机 sid，状态在服务端 dict——吊销 = 删一行，重启默认全掉线",
        "签名 cookie：状态（用户名|过期时间）在 cookie 本体，HMAC 防篡改——无状态但发出即收不回"
      ]
    },
    {
      "dot": "amber",
      "title": "Set-Cookie 安全属性",
      "items": [
        "HttpOnly 挡 JS 读取（防 XSS 偷 cookie）；SameSite=Lax 限跨站携带（防 CSRF）",
        "Max-Age/Expires 控浏览器侧过期；校验侧还要再查一次 exp——签名防篡改，不防过期"
      ]
    }
  ]
}