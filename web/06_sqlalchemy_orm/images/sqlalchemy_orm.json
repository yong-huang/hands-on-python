  "cards": [
    {
      "dot": "amber",
      "title": "session 生命周期（实测）",
      "items": [
        "expire_on_commit 默认开：commit 后首次读属性隐式补发 1 条 SELECT",
        "会话关闭后读过期属性 → DetachedInstanceError；Web 里一请求一 session 是标配"
      ]
    },
    {
      "dot": "cyan",
      "title": "Alembic 加列不丢数据（实测）",
      "items": [
        "upgrade 0001 建表 → 插入老数据 → upgrade head：posts 多出 views 列",
        "server_default=\"0\" 让旧行自动填默认值，alembic_version 表记录迁移进度"
      ]
    }
  ]
