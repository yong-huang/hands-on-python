    },
    {
      "id": "model",
      "lane": "main",
      "col": 2,
      "type": "backend",
      "label": "Pydantic 字段约束",
      "width": 170
    },
    {
      "id": "handler",
      "lane": "main",
      "col": 3,
      "type": "messagebus",
      "label": "handler 只写业务",
      "width": 160
    },
    {
      "id": "filter",
      "lane": "main",
      "col": 4,
      "type": "security",
      "label": "response_model 出口闸",
      "width": 180
    },
    {
      "id": "response",
      "lane": "main",
      "col": 5,
      "type": "messagebus",
      "label": "JSON + OpenAPI 文档",
