  "edges": [
    {
      "id": "e1",
      "from": "request",
      "to": "parse",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "parse",
      "to": "model"
    },
    {
      "id": "e3",
      "from": "model",
      "to": "handler",
      "label": "已验证实例",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "handler",
      "to": "filter",
      "label": "全量 dict"
    },
    {
      "id": "e5",
      "from": "filter",
      "to": "response"
    },
    {
      "id": "e6",
      "from": "model",
      "to": "err422",
      "label": "任一约束违例"
